// Set this to your Render URL to test the deployed API, or use http://localhost:3001 locally.
@host = http://localhost:3001

### Get all contacts
GET {{host}}/contacts
Accept: application/json

### Get contact by id
GET {{host}}/contacts/6aa9ab499bf001dc1b95669b
Accept: application/json

### Create contact
POST {{host}}/contacts
Content-Type: application/json

{
    "firstName": "Carlos",
    "lastName": "Mendez",
    "email": "carlos.mendez@example.com",
    "favoriteColor": "blue",
    "birthday": "1995-08-23"
}

### Update contact
PUT {{host}}/contacts/6aa9ab499bf001dc1b95669b
Content-Type: application/json

{
    "firstName": "Carlos",
    "lastName": "Mendez",
    "email": "carlos.mendez@example.com",
    "favoriteColor": "yellow",
    "birthday": "1995-08-23"
}

### Delete contact
DELETE {{host}}/contacts/6aa9ab499bf001dc1b95669b
