{
  "swagger": "2.0",
  "info": {
    "title": "Contacts API",
    "description": "REST API to create, read, update and delete contacts stored in MongoDB.",
    "version": "1.0.0"
  },
  "host": "project01-bk00.onrender.com",
  "basePath": "/",
  "tags": [
    {
      "name": "Home",
      "description": "Base route of the Contacts API"
    },
    {
      "name": "Contacts",
      "description": "CRUD operations on the contacts collection"
    }
  ],
  "schemes": [
    "https"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Home"
        ],
        "summary": "Welcome message",
        "description": "Base route of the Contacts API. Use /contacts for the CRUD endpoints.",
        "produces": [
          null
        ],
        "responses": {
          "200": {
            "description": "OK - Returns a welcome message."
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "description": "Returns every contact stored in the contacts collection.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK - Returns an array of contacts.",
            "schema": {
              "$ref": "#/definitions/ContactList"
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a new contact",
        "description": "Creates a contact in MongoDB. All five fields are required. Returns the id of the new contact.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "The contact to create. All five fields are required. Do not send an _id, MongoDB assigns it.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            },
            "example": {
              "firstName": "Sofia",
              "lastName": "Ramirez",
              "email": "sofia.ramirez@example.com",
              "favoriteColor": "purple",
              "birthday": "1998-04-12"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created - Returns the id of the newly created contact.",
            "schema": {
              "$ref": "#/definitions/ContactId"
            }
          },
          "400": {
            "description": "Bad Request - One or more required fields are missing or invalid."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get a contact by id",
        "description": "Returns a single contact matching the provided id.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the contact"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Returns the requested contact.",
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          },
          "400": {
            "description": "Bad Request - The id is not a valid ObjectId."
          },
          "404": {
            "description": "Not Found - No contact exists with that id."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update an existing contact",
        "description": "Replaces the contact matching the provided id. All five fields are required.",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the contact to update"
          },
          {
            "name": "body",
            "in": "body",
            "description": "The new values for the contact. All five fields are required. Do not send an _id.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            },
            "example": {
              "firstName": "Sofia",
              "lastName": "Ramirez",
              "email": "sofia.ramirez@example.com",
              "favoriteColor": "green",
              "birthday": "1998-04-12"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content - The contact was updated."
          },
          "400": {
            "description": "Bad Request - Invalid id, or a required field is missing."
          },
          "404": {
            "description": "Not Found - No contact exists with that id."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete a contact",
        "description": "Removes the contact matching the provided id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the contact to delete"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content - The contact was deleted."
          },
          "400": {
            "description": "Bad Request - The id is not a valid ObjectId."
          },
          "404": {
            "description": "Not Found - No contact exists with that id."
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "ContactInput": {
      "description": "The five fields required to create or replace a contact. The _id is generated by MongoDB and must not be sent.",
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "favoriteColor",
        "birthday"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Sofia"
        },
        "lastName": {
          "type": "string",
          "example": "Ramirez"
        },
        "email": {
          "type": "string",
          "example": "sofia.ramirez@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "purple"
        },
        "birthday": {
          "type": "string",
          "example": "1998-04-12"
        }
      }
    },
    "Contact": {
      "description": "A stored contact, including the _id that MongoDB assigned on insert.",
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "favoriteColor",
        "birthday"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "description": "Assigned by MongoDB when the contact is created. Not sent by the client.",
          "example": "6ab6bd0406634384d69bc582"
        },
        "firstName": {
          "type": "string",
          "example": "Sofia"
        },
        "lastName": {
          "type": "string",
          "example": "Ramirez"
        },
        "email": {
          "type": "string",
          "example": "sofia.ramirez@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "purple"
        },
        "birthday": {
          "type": "string",
          "example": "1998-04-12"
        }
      }
    },
    "ContactList": {
      "description": "A list of stored contacts.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Contact"
      }
    },
    "ContactId": {
      "description": "The _id of a newly created contact, assigned by MongoDB.",
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "6ab6bd0406634384d69bc582"
        }
      }
    }
  }
}